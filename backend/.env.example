# Serveur
PORT=5000
NODE_ENV=development

# NASA FIRMS — seule clé API requise
# Inscription : https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=your_nasa_firms_api_key

# MongoDB
MONGODB_URI=mongodb://localhost:27017/firemaps

# Sécurité
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cache (secondes)
CACHE_TTL=300

# Logs
LOG_LEVEL=info
