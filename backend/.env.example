# Serveur
PORT=5000
NODE_ENV=development

# Clés API (ne jamais committer)
FIRMS_API_KEY=your_nasa_firms_api_key
METEO_FRANCE_API_KEY=your_meteo_france_client_id
METEO_FRANCE_API_SECRET=your_meteo_france_client_secret

# Base de données
MONGODB_URI=mongodb://localhost:27017/firemaps

# Sécurité
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cache (secondes)
CACHE_TTL=300

# Logs
LOG_LEVEL=info
